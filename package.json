{
  "name": "agentscrape",
  "version": "0.1.0",
  "description": "Fetch and extract web content through an agent-friendly Bun CLI",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/api.ts",
    "./feed": "./src/feed.ts",
    "./presets": "./src/presets.ts",
    "./schemas": "./src/schemas.ts"
  },
  "bin": {
    "agentscrape": "./src/cli.ts"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write src test",
    "typecheck": "tsc --noEmit",
    "test": "bun test --parallel=1 --max-concurrency=1 --timeout 60000",
    "x-readiness": "bun run scripts/check-x-readiness.ts",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "fast-xml-parser": "5.10.1",
    "markdown-it": "14.1.0",
    "turndown": "7.2.2",
    "yaml": "2.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/bun": "1.3.14",
    "@types/markdown-it": "14.1.2",
    "@types/turndown": "5.0.6",
    "bun-types": "1.3.14",
    "typescript": "5.9.3"
  }
}
